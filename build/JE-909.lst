 233:JE-909.cpp    **** 	float base_freq = 50.f;
 234:JE-909.cpp    **** 	float drive_amount = 0.0f;
 235:JE-909.cpp    **** 	float level = 0.8f;
 236:JE-909.cpp    **** 
 237:JE-909.cpp    **** 	ExpDecayEnv env1_body;   // ENV-1: body amplitude, responsible for punch
