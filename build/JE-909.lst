 270:JE-909.cpp    **** 	void SetParrams(float tune_knob, float decay_knob, float drive_knob, float level_knob)
 271:JE-909.cpp    **** 	{
 272:JE-909.cpp    **** 		base_freq = MapExp(tune_knob, 32.70f, 65.41f);
 273:JE-909.cpp    **** 
 274:JE-909.cpp    **** 		float decay_seconds = MapExp(decay_knob, 0.10f, 1.60f);
 275:JE-909.cpp    **** 		env1_body.SetDecay(decay_seconds);
 276:JE-909.cpp    **** 
 277:JE-909.cpp    **** 		env2_attack.SetDecay(0.014f);
 278:JE-909.cpp    **** 		env3_pitch.SetDecay(0.035f);
 279:JE-909.cpp    **** 		pulse_env.SetDecay(0.0011f);
 280:JE-909.cpp    **** 
 281:JE-909.cpp    **** 		drive_amount = Clamp(drive_knob, 0.0f, 1.0f);
 282:JE-909.cpp    **** 
 283:JE-909.cpp    **** 		level = level_knob * 1.25f;
 284:JE-909.cpp    **** 	}
 285:JE-909.cpp    **** 
 286:JE-909.cpp    **** 	void Trigger()
 287:JE-909.cpp    **** 	{
 288:JE-909.cpp    **** 		env1_body.Trigger();
 289:JE-909.cpp    **** 		env2_attack.Trigger();
 290:JE-909.cpp    **** 		env3_pitch.Trigger();
 291:JE-909.cpp    **** 		pulse_env.Trigger();
 292:JE-909.cpp    **** 
 293:JE-909.cpp    **** 		phase = 0.0f;
 294:JE-909.cpp    **** 	}
 295:JE-909.cpp    **** 
 296:JE-909.cpp    **** 	float WhiteNoise()
 297:JE-909.cpp    **** 	{
ARM GAS  /var/folders/5h/m58cqcc50w3bl35rb6m75qwc0000gn/T//ccMbPTFj.s 			page 17


 298:JE-909.cpp    **** 		rng = 1664525UL * rng + 1013904223UL;
 299:JE-909.cpp    **** 
 300:JE-909.cpp    **** 		uint32_t bits = (rng >> 9) | 0x3f800000UL;
 301:JE-909.cpp    **** 		
 302:JE-909.cpp    **** 		union 
 303:JE-909.cpp    **** 		{
 304:JE-909.cpp    **** 			uint32_t i;
 305:JE-909.cpp    **** 			float f;
 306:JE-909.cpp    **** 		} u;
 307:JE-909.cpp    **** 
 308:JE-909.cpp    **** 		u.i = bits;
 309:JE-909.cpp    **** 
 310:JE-909.cpp    **** 		float uni = u.f - 1.0f;
 311:JE-909.cpp    **** 
 312:JE-909.cpp    **** 		return uni * 2.0f - 1.0f;
 313:JE-909.cpp    **** 	}
 314:JE-909.cpp    **** 
 315:JE-909.cpp    **** 	float DiodeShape(float x)
 316:JE-909.cpp    **** 	{
 317:JE-909.cpp    **** 		float shape_gain = 1.85f;
 318:JE-909.cpp    **** 
 319:JE-909.cpp    **** 		float y = tanhf(x * shape_gain);
 320:JE-909.cpp    **** 
 321:JE-909.cpp    **** 		y /= tanhf(shape_gain);
 322:JE-909.cpp    **** 
 323:JE-909.cpp    **** 		return y;
 324:JE-909.cpp    **** 	}
 325:JE-909.cpp    **** 
 326:JE-909.cpp    **** 	float Drive(float x)
 327:JE-909.cpp    **** 	{ 
 328:JE-909.cpp    **** 		float d = drive_amount;
 329:JE-909.cpp    **** 
 330:JE-909.cpp    **** 		float pregain = 1.0f + 24.0f * d * d;
 331:JE-909.cpp    **** 		float bias = 0.08f * d;
 332:JE-909.cpp    **** 
 333:JE-909.cpp    **** 		float saturated = tanhf((x * pregain) + bias) - tanhf(bias);
 334:JE-909.cpp    **** 
 335:JE-909.cpp    **** 		float norm = tanhf(pregain);
 336:JE-909.cpp    **** 
 337:JE-909.cpp    **** 		if(norm > 0.0001f)
 338:JE-909.cpp    **** 			saturated /= norm;
 339:JE-909.cpp    **** 
 340:JE-909.cpp    **** 		float y = (1.0f - d) * x + d * saturated;
 341:JE-909.cpp    **** 
 342:JE-909.cpp    **** 		return y;
 343:JE-909.cpp    **** 	}
