 424:JE-909.cpp    **** // Sidechain duck envelope
 425:JE-909.cpp    **** // ------------------------------------------------------------
 426:JE-909.cpp    **** 
 427:JE-909.cpp    **** float duck_env = 0.0f;
 428:JE-909.cpp    **** float duck_coeff = 0.999f;
 429:JE-909.cpp    **** 
 430:JE-909.cpp    **** void TriggerDuck()
 431:JE-909.cpp    **** {
 432:JE-909.cpp    **** 	duck_env = 1.0f;
 433:JE-909.cpp    **** }
 434:JE-909.cpp    **** 
 435:JE-909.cpp    **** float ProcessDuck()
 436:JE-909.cpp    **** {
 437:JE-909.cpp    **** 	float out = duck_env;
 438:JE-909.cpp    **** 
 439:JE-909.cpp    **** 	duck_env *= duck_coeff;
 440:JE-909.cpp    **** 
 441:JE-909.cpp    **** 	if(duck_env < 0.000001f)
 442:JE-909.cpp    **** 		duck_env = 0.0f;
 443:JE-909.cpp    **** 
 444:JE-909.cpp    **** 	return out;
 445:JE-909.cpp    **** }
