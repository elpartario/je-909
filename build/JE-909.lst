 389:JE-909.cpp    **** 		// ------------------------------------------------------------
 390:JE-909.cpp    ****         // Attack path: pulse + noise
 391:JE-909.cpp    ****         // Pulse is shaped by low-pass and band-pass filtering.
 392:JE-909.cpp    ****         // Noise is low-pass filtered.
 393:JE-909.cpp    ****         // Both pass through VCA controlled by ENV-2.
 394:JE-909.cpp    ****         // ------------------------------------------------------------
 395:JE-909.cpp    **** 
 396:JE-909.cpp    **** 		float pulse_lp = pulse_lpf.Process(pulse_e);
 397:JE-909.cpp    **** 		float pulse_bp = pulse_bpf.Process(pulse_e);
 398:JE-909.cpp    **** 		float pulse = (0.62f * pulse_lp) + (0.38f * pulse_bp);
 399:JE-909.cpp    **** 
 400:JE-909.cpp    **** 		float raw_noise = WhiteNoise();
 401:JE-909.cpp    **** 		float filtered_noise = noise_lpf.Process(raw_noise);
 402:JE-909.cpp    **** 
 403:JE-909.cpp    **** 		float attack = ((0.90f * pulse) + (0.22f * filtered_noise)) * env2;
