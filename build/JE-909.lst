  32:JE-909.cpp    **** static inline float Clamp(float x, float lo, float hi)
  33:JE-909.cpp    **** {
  34:JE-909.cpp    **** 	if (x < lo) return lo;
  35:JE-909.cpp    **** 	if (x > hi) return hi;
  36:JE-909.cpp    **** 	return x;
  37:JE-909.cpp    **** }
  38:JE-909.cpp    **** 
  39:JE-909.cpp    **** static inline float MapLin(float x, float out_min, float out_max)
  40:JE-909.cpp    **** {
  41:JE-909.cpp    **** 	x = Clamp(x, 0.0f, 1.0f);
  42:JE-909.cpp    **** 	return out_min + x * (out_max - out_min);
  43:JE-909.cpp    **** }
  44:JE-909.cpp    **** 
  45:JE-909.cpp    **** static inline float MapExp(float x, float out_min, float out_max)
  46:JE-909.cpp    **** {
  47:JE-909.cpp    **** 	x = Clamp(x, 0.0f, 1.0f);
  48:JE-909.cpp    **** 
  49:JE-909.cpp    **** 	// Exponential mapping is better for frequency and time
  50:JE-909.cpp    ****     // because our ears do not perceive those linearly.
  51:JE-909.cpp    **** 	return out_min * powf(out_max / out_min, x);
  52:JE-909.cpp    **** }
  53:JE-909.cpp    **** 
  54:JE-909.cpp    **** static inline float OnePoleCoeff(float cutoff_hz, float sample_rate)
  55:JE-909.cpp    **** {
  56:JE-909.cpp    **** 	cutoff_hz = Clamp(cutoff_hz, 1.0f, sample_rate * 0.45f);
  57:JE-909.cpp    **** 	return 1.0f - expf(-TWO_PI * cutoff_hz / sample_rate);
  58:JE-909.cpp    **** }
  59:JE-909.cpp    **** 
  60:JE-909.cpp    **** // ------------------------------------------------------------
  61:JE-909.cpp    **** // Exponential decay envelope
  62:JE-909.cpp    **** // This models the behavior of a capacitor discharging through
  63:JE-909.cpp    **** // a resistor: V(t) = V0 * e^(-t / tau)
  64:JE-909.cpp    **** // ------------------------------------------------------------
  65:JE-909.cpp    **** 
  66:JE-909.cpp    **** struct ExpDecayEnv
  67:JE-909.cpp    **** {
  68:JE-909.cpp    **** 	float sample_rate = 48000.0f;
  69:JE-909.cpp    **** 	float value = 0.0f;
ARM GAS  /var/folders/5h/m58cqcc50w3bl35rb6m75qwc0000gn/T//ccMbPTFj.s 			page 13


  70:JE-909.cpp    **** 	float coeff = 0.999f;
  71:JE-909.cpp    **** 
  72:JE-909.cpp    **** 	void Init(float sr, float decay_seconds)
  73:JE-909.cpp    **** 	{
  74:JE-909.cpp    **** 		sample_rate = sr;
  75:JE-909.cpp    **** 		SetDecay(decay_seconds);
  76:JE-909.cpp    **** 		value = 0.0f;
  77:JE-909.cpp    **** 	}
  78:JE-909.cpp    **** 
  79:JE-909.cpp    **** 	void SetDecay(float decay_seconds)
  80:JE-909.cpp    **** 	{
  81:JE-909.cpp    **** 		decay_seconds = Clamp(decay_seconds, 0.0001f, 10.0f);
  82:JE-909.cpp    **** 		coeff = expf(-1.0f / (decay_seconds * sample_rate));
  83:JE-909.cpp    **** 	}
  84:JE-909.cpp    **** 
  85:JE-909.cpp    **** 	void Trigger()
  86:JE-909.cpp    **** 	{
  87:JE-909.cpp    **** 		value = 1.0f;
  88:JE-909.cpp    **** 	}
  89:JE-909.cpp    **** 
  90:JE-909.cpp    **** 	float Process()
  91:JE-909.cpp    **** 	{
  92:JE-909.cpp    **** 		float out = value;
  93:JE-909.cpp    **** 
  94:JE-909.cpp    **** 		value *= coeff;
  95:JE-909.cpp    **** 
  96:JE-909.cpp    **** 		if(value < 0.000001f)
  97:JE-909.cpp    **** 			value = 0.0f;
  98:JE-909.cpp    **** 		return out;
  99:JE-909.cpp    **** 	}
 100:JE-909.cpp    **** };
 101:JE-909.cpp    **** 
 102:JE-909.cpp    **** // ------------------------------------------------------------
 103:JE-909.cpp    **** // One-pole low-pass filter
 104:JE-909.cpp    **** // Digital equivalent of a simple RC low-pass filter.
 105:JE-909.cpp    **** // ------------------------------------------------------------
 106:JE-909.cpp    **** 
 107:JE-909.cpp    **** struct OnePoleLPF
 108:JE-909.cpp    **** {
 109:JE-909.cpp    **** 	float sample_rate = 48000.0f;
 110:JE-909.cpp    **** 	float z = 0.0f;
 111:JE-909.cpp    **** 	float a = 0.1f;
 112:JE-909.cpp    **** 
 113:JE-909.cpp    **** 	void Init(float sr, float cutoff_hz)
 114:JE-909.cpp    **** 	{ 
 115:JE-909.cpp    **** 		sample_rate = sr;
 116:JE-909.cpp    **** 		z = 0.0f;
 117:JE-909.cpp    **** 		SetCutoff(cutoff_hz);
 118:JE-909.cpp    **** 	}
 119:JE-909.cpp    **** 
 120:JE-909.cpp    **** 	void SetCutoff(float cutoff_hz)
 121:JE-909.cpp    **** 	{ 
 122:JE-909.cpp    **** 		a = OnePoleCoeff(cutoff_hz, sample_rate);
 123:JE-909.cpp    **** 	}
 124:JE-909.cpp    **** 
 125:JE-909.cpp    **** 	float Process(float x)
 126:JE-909.cpp    **** 	{
ARM GAS  /var/folders/5h/m58cqcc50w3bl35rb6m75qwc0000gn/T//ccMbPTFj.s 			page 14


 127:JE-909.cpp    **** 		z += a * (x - z);
 128:JE-909.cpp    **** 		return z;
 129:JE-909.cpp    **** 	}
 130:JE-909.cpp    **** 
 131:JE-909.cpp    **** };
 132:JE-909.cpp    **** 
 133:JE-909.cpp    **** // ------------------------------------------------------------
 134:JE-909.cpp    **** // Biquad band-pass filter
 135:JE-909.cpp    **** // This is used to model the band-pass part of the 909 pulse
 136:JE-909.cpp    **** // shaping circuit.
 137:JE-909.cpp    **** // ------------------------------------------------------------
 138:JE-909.cpp    **** 
 139:JE-909.cpp    **** struct BiquadBandpass
 140:JE-909.cpp    **** {
 141:JE-909.cpp    **** 	float sample_rate = 48000.0f;
 142:JE-909.cpp    **** 
 143:JE-909.cpp    **** 	float b0 = 0.0f;
 144:JE-909.cpp    **** 	float b1 = 0.0f;
 145:JE-909.cpp    **** 	float b2 = 0.0f;
 146:JE-909.cpp    **** 	float a1 = 0.0f;
 147:JE-909.cpp    **** 	float a2 = 0.0f;
 148:JE-909.cpp    **** 
 149:JE-909.cpp    **** 	float x1 = 0.0f;
 150:JE-909.cpp    **** 	float x2 = 0.0f;
 151:JE-909.cpp    **** 	float y1 = 0.0f;
 152:JE-909.cpp    **** 	float y2 = 0.0f;
 153:JE-909.cpp    **** 
 154:JE-909.cpp    **** 	void Init(float sr, float cutoff_hz, float q)
 155:JE-909.cpp    **** 	{
 156:JE-909.cpp    **** 		sample_rate = sr;
 157:JE-909.cpp    **** 		x1 = x2 = y1 = y2 = 0.0f;
 158:JE-909.cpp    **** 		Set(cutoff_hz, q);
 159:JE-909.cpp    **** 	}
 160:JE-909.cpp    **** 
 161:JE-909.cpp    **** 	void Set(float cutoff_hz, float q)
 162:JE-909.cpp    **** 	{
 163:JE-909.cpp    **** 		cutoff_hz = Clamp(cutoff_hz, 20.0f, sample_rate * 0.45f);
 164:JE-909.cpp    **** 		q = Clamp(q, 0.1f, 10.0f);
 165:JE-909.cpp    **** 
 166:JE-909.cpp    **** 		float omega = TWO_PI * cutoff_hz / sample_rate;
 167:JE-909.cpp    **** 		float sn = sinf(omega);
 168:JE-909.cpp    **** 		float cs = cosf(omega);
 169:JE-909.cpp    **** 		float alpha = sn / (2.0f * q);
 170:JE-909.cpp    **** 
 171:JE-909.cpp    **** 		float raw_b0 = alpha;
 172:JE-909.cpp    **** 		float raw_b1 = 0.0f;
 173:JE-909.cpp    **** 		float raw_b2 = -alpha;
 174:JE-909.cpp    **** 		float raw_a0 = 1.0f + alpha;
 175:JE-909.cpp    **** 		float raw_a1 = -2.0f * cs;
 176:JE-909.cpp    **** 		float raw_a2 = 1.0f - alpha;
 177:JE-909.cpp    **** 
 178:JE-909.cpp    **** 		b0 = raw_b0 / raw_a0;
 179:JE-909.cpp    ****         b1 = raw_b1 / raw_a0;
 180:JE-909.cpp    ****         b2 = raw_b2 / raw_a0;
 181:JE-909.cpp    ****         a1 = raw_a1 / raw_a0;
 182:JE-909.cpp    ****         a2 = raw_a2 / raw_a0;
 183:JE-909.cpp    **** 	}
ARM GAS  /var/folders/5h/m58cqcc50w3bl35rb6m75qwc0000gn/T//ccMbPTFj.s 			page 15


 184:JE-909.cpp    **** 
 185:JE-909.cpp    **** 	float Process (float x)
 186:JE-909.cpp    **** 	{
 187:JE-909.cpp    **** 		float y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
 188:JE-909.cpp    **** 
 189:JE-909.cpp    **** 		x2 = x1;
 190:JE-909.cpp    **** 		x1 = x;
 191:JE-909.cpp    **** 
 192:JE-909.cpp    **** 		y2 = y1;
 193:JE-909.cpp    **** 		y1 = y;
 194:JE-909.cpp    **** 
 195:JE-909.cpp    **** 		return y;
 196:JE-909.cpp    **** 	}
 197:JE-909.cpp    **** };
 198:JE-909.cpp    **** 
 199:JE-909.cpp    **** // ------------------------------------------------------------
 200:JE-909.cpp    **** // DC blocker
 201:JE-909.cpp    **** // Removes offset from asymmetric saturation.
 202:JE-909.cpp    **** // Similar in purpose to AC coupling at an analog output.
 203:JE-909.cpp    **** // ------------------------------------------------------------
 204:JE-909.cpp    **** 
 205:JE-909.cpp    **** struct DCBlocker
 206:JE-909.cpp    **** {
 207:JE-909.cpp    **** 	float x1 = 0.0f;
 208:JE-909.cpp    **** 	float y1 = 0.0f;
 209:JE-909.cpp    **** 	float R = 0.995f;
 210:JE-909.cpp    **** 
 211:JE-909.cpp    **** 	void Init()
 212:JE-909.cpp    **** 	{
 213:JE-909.cpp    **** 		x1 = 0.0f;
 214:JE-909.cpp    **** 		y1 = 0.0f;
 215:JE-909.cpp    **** 	}
 216:JE-909.cpp    **** 
 217:JE-909.cpp    **** 	float Process(float x)
 218:JE-909.cpp    **** 	{
 219:JE-909.cpp    **** 		float y = x - x1 + R * y1;
 220:JE-909.cpp    **** 
 221:JE-909.cpp    **** 		x1 = x;
 222:JE-909.cpp    **** 		y1 = y;
 223:JE-909.cpp    **** 
 224:JE-909.cpp    **** 		return y;
 225:JE-909.cpp    **** 	}
 226:JE-909.cpp    **** };
 227:JE-909.cpp    **** 
 228:JE-909.cpp    **** struct Kick909
 229:JE-909.cpp    **** {
